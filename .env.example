# Base URLs
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
EXPO_PUBLIC_IMAGE_BASE_URL=https://cdn.example.com/images
EXPO_PUBLIC_SOCKET_URL=ws://127.0.0.1:4000
EXPO_PUBLIC_APP_VERSION=1.0.0

# Third Party Keys (Do not put real keys here)
EXPO_PUBLIC_GOOGLE_MAP_KEY=your_google_maps_key
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_RAZORPAY_KEY=your_razorpay_key

# Feature Flags
EXPO_PUBLIC_ENABLE_WALLET=true
EXPO_PUBLIC_ENABLE_CHAT=false
