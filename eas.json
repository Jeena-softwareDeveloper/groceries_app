{
  "cli": {
    "version": ">= 21.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://atmapi.ponnilamfincorp.com",
        "EXPO_PUBLIC_IMAGE_BASE_URL": "https://atmapi.ponnilamfincorp.com/uploads",
        "EXPO_PUBLIC_SOCKET_URL": "wss://atmapi.ponnilamfincorp.com",
        "EXPO_PUBLIC_APP_VERSION": "1.0.0"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://atmapi.ponnilamfincorp.com",
        "EXPO_PUBLIC_IMAGE_BASE_URL": "https://atmapi.ponnilamfincorp.com/uploads",
        "EXPO_PUBLIC_SOCKET_URL": "wss://atmapi.ponnilamfincorp.com",
        "EXPO_PUBLIC_APP_VERSION": "1.0.0"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://atmapi.ponnilamfincorp.com",
        "EXPO_PUBLIC_IMAGE_BASE_URL": "https://atmapi.ponnilamfincorp.com/uploads",
        "EXPO_PUBLIC_SOCKET_URL": "wss://atmapi.ponnilamfincorp.com",
        "EXPO_PUBLIC_APP_VERSION": "1.0.0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
